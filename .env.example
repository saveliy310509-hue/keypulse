# Скопируй в .env и заполни
BOT_TOKEN=
ADMIN_ID=8554520733

API_HOST=0.0.0.0
API_PORT=8080
API_SECRET=change_me_to_long_random_string

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Локальная SQLite (VPS, свой ПК, Docker)
DATABASE_PATH=data/keypulse.db

# Turso/libSQL для Render/Fly free (диск там стирается).
# Если задано LIBSQL_URL — DATABASE_PATH игнорируется.
LIBSQL_URL=
LIBSQL_AUTH_TOKEN=

# Render free: бот пингует свой URL, чтобы сервис не засыпал
# Пример: KEEPALIVE_URL=https://keypulse.onrender.com/health
KEEPALIVE_URL=
KEEPALIVE_INTERVAL=600
